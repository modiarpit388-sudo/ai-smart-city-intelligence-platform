# Copy to backend/.env (or export as environment variables)

# --- required in production ---
SECRET_KEY=change-me-to-a-long-random-string

# --- database (default: SQLite file in backend/instance/) ---
# DATABASE_URL=postgresql://smartcity:smartcity@localhost:5432/smartcity

# --- optional: let the AI City Assistant phrase answers with an LLM ---
# (answers stay grounded in your database + ML output)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5

# --- email verification (OTP on registration) ---
# Easiest: run  python manage.py setupmail   (see EMAIL_SETUP.md). Without email settings the OTP is printed in the console.
# MAIL_PROVIDER=brevo          # recommended; or smtp
# BREVO_API_KEY=xkeysib-...
# MAIL_FROM=Smart City AI <sender-verified-in-brevo@gmail.com>
# Gmail: enable 2-Step Verification, create an "App password" and use it as SMTP_PASSWORD.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587                 # 587 = STARTTLS, 465 = SSL (also set SMTP_USE_SSL=true)
# SMTP_USE_SSL=false
# SMTP_USER=youraddress@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# MAIL_FROM=Smart City AI <youraddress@gmail.com>
# OTP_EXPIRY_MINUTES=10
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_SECONDS=60

# --- data volume generated on first start ---
# HOURLY_HISTORY_DAYS=90
# DAILY_HISTORY_DAYS=150
# ELECTRICITY_HISTORY_DAYS=150
PORT=5000
