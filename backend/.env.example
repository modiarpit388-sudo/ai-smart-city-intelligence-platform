# ============================================================
#  Smart City AI - settings.
#  EASIEST: run   python manage.py setupmail   and answer the questions.
#  (Or fill the lines below by hand, then restart:  python run.py)
# ============================================================

SECRET_KEY=change-me-to-a-long-random-string

# ---------- Email OTP: option 1 (RECOMMENDED) - Brevo ----------
# Free, reaches every inbox reliably. See EMAIL_SETUP.md
# Leave MAIL_PROVIDER empty: Brevo is used automatically when BREVO_API_KEY is filled.
MAIL_PROVIDER=
BREVO_API_KEY=
# Must be the sender address you verified inside Brevo, e.g. Smart City AI <you@gmail.com>
MAIL_FROM=

# ---------- Email OTP: option 2 - Gmail (testing only) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_USER=
SMTP_PASSWORD=

OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60

# ---------- Login sessions ----------
# Change this text to sign EVERYONE out at once (all old logins stop working).
# SESSION_KEY=v1
